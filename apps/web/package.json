{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js 16 dashboard for @bymax-one/nest-ai-tokens: Overview, Playground, Ledger, Pricing, Usage, Quota Lab, Tenants, and Errors.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@bymax-one/nest-ai-tokens": "file:../../../nest-ai-tokens",
    "geist": "^1.7.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "vitest": "^3"
  }
}
