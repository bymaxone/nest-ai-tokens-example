{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS reference API for @bymax-one/nest-ai-tokens: Prisma data layer over the library's reference schema.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/node": "^24.0.0",
    "dotenv": "^17.2.4",
    "jest": "^30.4.2",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
