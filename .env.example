# Environment registry for nest-ai-tokens-example.
#
# Copy this file to `.env` at the repo root and adjust as needed. Every value
# below is a local-only default; no secret ever has a real value in this file.
# The registry grows as the API and web apps gain configuration surface.

# Prisma connection string for the compose Postgres (local-only credentials).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_tokens_example

# Port the NestJS API listens on.
PORT=3001

# AI provider layer for the workspace endpoints: 'mock' (deterministic, the
# only mode CI ever runs) or 'openai-optin' (local-only opt-in; never CI).
AI_PROVIDER_MODE=mock

# Enables the library's enforcement surface (wallets + budgets feature blocks:
# WalletService, BudgetService, BudgetGuard).
QUOTA_ENABLED=true

# App-side multiplier applied when the API sizes spend holds from its own
# token estimates (headroom over the raw estimate).
QUOTA_TOLERANCE=1.2

# Lowest wallet balance a debit may leave, in USD. Zero or positive means no
# overdraft; a negative floor becomes the library's overdraft allowance.
QUOTA_MINIMUM_BALANCE=0

# When true, requests whose demo identity carries no tenant are rejected
# instead of falling back to the global tenant.
TENANT_REQUIRED=false

# In-memory price-rate cache TTL in milliseconds (pricing.cacheTtlMs).
PRICING_CACHE_TTL_MS=300000

# Artificial latency (ms) the deterministic mock inference layer adds to each
# call so a dashboard shows a believable spinner. Keep 0 for tests/CI.
MOCK_LATENCY_MS=0

# Comma-separated allow-list of browser origins the API grants CORS to. The
# dashboard runs on a different port than the API, so its client-side fetches
# are cross-origin; an Origin not listed here receives no CORS headers. Each
# entry is normalized to its URL origin. Default: the local dashboard dev
# origin (set this to the deployed dashboard origin in a real deployment).
WEB_ORIGIN=http://localhost:3000
